# =============================================================
# PPTx AI Configuration — FREE & PAID OPTIONS
# =============================================================

# ┌─────────────────────────────────────────────────────────┐
# │  RECOMMENDED FREE OPTION: OpenRouter                    │
# │  Sign up (no credit card): https://openrouter.ai       │
# │  Model: moonshotai/kimi-k3 (FREE with rate limits)     │
# └─────────────────────────────────────────────────────────┘
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# =============================================================
# ALTERNATIVE PAID OPTIONS (higher limits, faster)
# =============================================================

# Kimi Direct API (trial credits on signup)
# Get your key from: https://platform.kimi.ai
# KIMI_API_KEY=sk-your-kimi-api-key-here

# TokenRouter (K2.x models only, K3 not yet available)
# Get your key from: https://tokenrouter.com
# TOKENROUTER_API_KEY=sk-your-tokenrouter-key-here

# =============================================================
# Model Selection
# =============================================================

# Default provider: openrouter (FREE), kimi_direct, or tokenrouter
PPTX_PROVIDER=openrouter

# Default model:
# OpenRouter: moonshotai/kimi-k3 (FREE!)
# Kimi Direct: kimi-k3, kimi-k2.7-code, kimi-k2.7-code-highspeed
# TokenRouter: kimi-k2p7-code, kimi-k2p7-code-fast, kimi-k2p6
PPTX_MODEL=moonshotai/kimi-k3

# Reasoning effort (kimi_direct K3 only): low, high, max
PPTX_REASONING_EFFORT=high
